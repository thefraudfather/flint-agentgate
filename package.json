{
  "name": "flint-agentgate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run typecheck && npm test && npm run build",
    "release:scan": "node scripts/release-check.mjs",
    "release:check": "npm run release:scan && npm run verify && npm audit --omit=dev --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "19.2.8",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "19.2.5",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "8.2.2"
  }
}
